<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- שינוי קריטי: שדרוג ל-net9.0-windows כדי להתאים לשאר הפרויקטים -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.0.0-preview.9.24556.5" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="9.0.0-preview.9.24556.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- References לפרויקטים השכנים -->
    <!-- וודא שהנתיבים האלו נכונים יחסית למיקום קובץ ה-csproj שלך -->
    <ProjectReference Include="..\Integrations\Jira\Jira.csproj" />
    <ProjectReference Include="..\Integrations\Confluence\Confluence.csproj" />
    <ProjectReference Include="..\Utils\Utils.csproj" />
  </ItemGroup>

</Project>