## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
launchSettings.json

# Visual Studio cache/options
.vs/
*.vscode/

# Build results
*.dll
*.exe
*.app
*.appx
*.apk
*.jar
*.war
*.msi
*.nupkg
*.bln
*.xap
*.ipa

# Debug/release folders
[Dd]ebug*/
[Rr]elease*/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Rider
.idea/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
*.nuget.props
*.nuget.targets

# Azure
.localhistory/
*.azurePubxml
*.pubxml
*.publishproj
PublishProfiles/

# Other
*.dbmdl
*.bak
*.ldf
*.mdf
*.log
*.dmp
*.tmp
*.tmp_proj

# OS-specific
[Dd]esktop.ini
[Tt]humbs.db
*.DS_Store
